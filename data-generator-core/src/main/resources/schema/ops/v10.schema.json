{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridgain.com/datagen/ops-v10.schema.json",
  "title": "Data Generator ops.yaml v10",
  "type": "object",
  "required": [
    "schema_version",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 10
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "otel": {
      "$ref": "#/$defs/otel"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "control": {
      "$ref": "#/$defs/control"
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": [
        "name",
        "root_schemas",
        "rate",
        "duration",
        "concurrency",
        "operations",
        "warmup",
        "key_space"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "root_schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rate": {
          "$ref": "#/$defs/rate"
        },
        "duration": {
          "$ref": "#/$defs/duration"
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stop_condition"
          }
        },
        "transaction_scope": {
          "enum": [
            "business_event",
            "none"
          ]
        },
        "provisioning": {
          "enum": [
            "skip",
            "emit",
            "apply"
          ],
          "default": "skip"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Worker threads this generator process drives. Each holds one operation in flight, so a single thread is capped at the reciprocal of the target round-trip latency regardless of \"rate\". \"rate\" stays the per-process target shared by the workers, not a per-thread figure. Every process in a fleet must use the same value: the key-space stripe that keeps workers from colliding is computed from it, and mixed values overlap."
        },
        "distribution": {
          "$ref": "#/$defs/distribution"
        },
        "operations": {
          "$ref": "#/$defs/operations"
        },
        "warmup": {
          "$ref": "#/$defs/warmup"
        },
        "key_space": {
          "$ref": "#/$defs/key_space"
        }
      }
    },
    "distribution": {
      "description": "Multi-pod execution. Absent => single-pod (legacy). When present, partition_count must be >= replicas; this is enforced in cross-element validation, not by the schema itself.",
      "type": "object",
      "required": [
        "replicas",
        "partition_count"
      ],
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "partition_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rate": {
      "oneOf": [
        {
          "$ref": "#/$defs/rate_constant"
        },
        {
          "$ref": "#/$defs/rate_ramped"
        },
        {
          "$ref": "#/$defs/rate_stepped"
        }
      ]
    },
    "rate_constant": {
      "type": "object",
      "required": [
        "kind",
        "ops_per_second"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "constant"
        },
        "ops_per_second": {
          "type": "number",
          "exclusiveMinimum": 0.0
        }
      }
    },
    "rate_ramped": {
      "type": "object",
      "required": [
        "kind",
        "from",
        "to",
        "over"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ramped"
        },
        "from": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "to": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "over": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rate_stepped": {
      "type": "object",
      "required": [
        "kind",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stepped"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "rate",
              "hold"
            ],
            "additionalProperties": false,
            "properties": {
              "rate": {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              "hold": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "duration": {
      "oneOf": [
        {
          "$ref": "#/$defs/duration_time"
        },
        {
          "$ref": "#/$defs/duration_count"
        },
        {
          "$ref": "#/$defs/duration_until_stop"
        }
      ]
    },
    "duration_time": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "time"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "duration_count": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "count"
        },
        "value": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "duration_until_stop": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "until_stop_condition"
        }
      }
    },
    "stop_condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/sc_latency_p99"
        },
        {
          "$ref": "#/$defs/sc_latency_p999"
        },
        {
          "$ref": "#/$defs/sc_error_rate"
        },
        {
          "$ref": "#/$defs/sc_external_signal"
        }
      ]
    },
    "sc_latency_p99": {
      "type": "object",
      "required": [
        "kind",
        "threshold"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "latency_p99_above"
        },
        "threshold": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sc_latency_p999": {
      "type": "object",
      "required": [
        "kind",
        "threshold"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "latency_p999_above"
        },
        "threshold": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sc_error_rate": {
      "type": "object",
      "required": [
        "kind",
        "threshold"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "error_rate_above"
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "sc_external_signal": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "external_signal"
        }
      }
    },
    "otel": {
      "type": "object",
      "required": [
        "exporter"
      ],
      "additionalProperties": false,
      "properties": {
        "exporter": {
          "enum": [
            "none",
            "otlp",
            "prometheus"
          ],
          "default": "none"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "description": "Optional live throughput/latency export to a Kafka topic. Absent => no live export.",
      "type": "object",
      "required": [
        "broker",
        "topic",
        "histogram_highest_ms",
        "histogram_significant_digits"
      ],
      "additionalProperties": false,
      "properties": {
        "broker": {
          "$ref": "#/$defs/broker_ref"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 100,
          "default": 1000
        },
        "histogram_highest_ms": {
          "description": "Longest single operation the whole-run latency histogram can record, in milliseconds. An operation slower than this is clamped to it rather than dropped, so a p99 pinned here reads as 'slower than we can measure'.",
          "type": "integer",
          "minimum": 1,
          "default": 60000
        },
        "histogram_significant_digits": {
          "description": "HdrHistogram precision in significant decimal digits. 3 gives 0.1% error and is the recommended value. Cost is roughly 100x per extra digit \u2014 the histogram is copied and encoded once per tick, so 3 digits is ~280KB per second and 5 would be ~21MB per second. Capped at 4 for that reason; the range bound (histogram_highest_ms) is nearly free by comparison, since memory is logarithmic in it.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 3
        }
      }
    },
    "control": {
      "description": "Optional runtime control channel: a Kafka topic the generator consumes rate commands from, so an external driver (e.g. the demo UI) can raise and lower load while the run is in flight. Absent => the scenario rate schedule paces the whole run.",
      "type": "object",
      "required": [
        "broker",
        "topic"
      ],
      "additionalProperties": false,
      "properties": {
        "broker": {
          "$ref": "#/$defs/broker_ref"
        },
        "topic": {
          "description": "Topic carrying ControlCommand JSON. Every instance consumes it under a unique group id, so a command broadcasts to the whole fleet.",
          "type": "string",
          "minLength": 1,
          "default": "datagen-control"
        }
      }
    },
    "broker_ref": {
      "description": "Which broker this channel uses. Either a reference to a message_brokers element the demo toolkit deployed \u2014 resolved at launch from the broker-endpoints.yaml the toolkit writes, so no address is copied into this file and a broker redeployed elsewhere is picked up on the next run \u2014 or a literal bootstrap address for a broker this demo does not own. Two disjoint configurations, not a value with a fallback: the document states which it means via 'kind' and the generator never guesses. The literal form is load-bearing rather than merely symmetrical, because the generator must not depend on the toolkit: without it a standalone run could not use metrics:/control: at all.",
      "oneOf": [
        {
          "title": "Deployed message broker (by name)",
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "element"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "x-source-section": "message_brokers",
              "description": "The key under 'message_brokers' in the toolkit's demo-config.yaml, e.g. 'payments-bus'. A broker appears in broker-endpoints.yaml only once it has been DEPLOYED, so naming a configured-but-undeployed broker fails at launch rather than silently disabling the channel. 'x-source-section' is a demo-config annotation borrowed here on purpose: it is what makes the UI render this field as a picker of configured broker names rather than a free-text box. It is not validated by this schema \u2014 the name is checked at launch against the endpoints file."
            }
          }
        },
        {
          "title": "Literal bootstrap address",
          "type": "object",
          "required": [
            "kind",
            "bootstrap_servers"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "address"
            },
            "bootstrap_servers": {
              "type": "string",
              "minLength": 1,
              "description": "Kafka bootstrap.servers, resolved from the GENERATOR's vantage point: cluster-internal DNS for an in-cluster run, a routable address on hosts. A consumer elsewhere (the demo UI, say) resolves its own address to the same broker and does not reuse this value."
            }
          }
        }
      ]
    },
    "operations": {
      "type": "object",
      "description": "Proportions of the scenario's operations. All three are required and must sum to 1.0 (checked at parse time, within 0.001). Replaces v9's read_ratio, which could not express put_get.",
      "required": [
        "put",
        "get",
        "put_get"
      ],
      "additionalProperties": false,
      "properties": {
        "put": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Write a generated row. Default 1.0 \u2014 an all-writes scenario."
        },
        "get": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Read one key drawn from the key space."
        },
        "put_get": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Read a key and then write it, as ONE operation \u2014 the read-modify-write a real application performs, and what PutGetBenchmark measures. Distinct from an interleaving of independent gets and puts."
        }
      },
      "default": {
        "put": 1.0,
        "get": 0.0,
        "put_get": 0.0
      }
    },
    "warmup": {
      "type": "object",
      "description": "Operations performed but NOT measured. Excluded from achieved_rate and from the reported latency percentiles, so a figure describes the cluster rather than the JVM's cold start. The operations still run and still populate the key space.",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/warmup_none"
        },
        {
          "$ref": "#/$defs/warmup_time"
        },
        {
          "$ref": "#/$defs/warmup_count"
        }
      ],
      "default": {
        "kind": "none"
      }
    },
    "warmup_none": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "none",
          "description": "Measure from the first operation."
        }
      }
    },
    "warmup_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "time"
        },
        "value": {
          "type": "string",
          "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+(\\.\\d+)?S)?)?$",
          "description": "ISO-8601 duration of wall time to discard, e.g. PT60S.",
          "default": "PT60S"
        }
      }
    },
    "warmup_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "count"
        },
        "value": {
          "type": "integer",
          "minimum": 1,
          "description": "Operations to discard, counted across the whole process. May overshoot by up to concurrency-1.",
          "default": 1000
        }
      }
    },
    "key_space": {
      "type": "object",
      "description": "The domain of keys this scenario addresses. 'bounded' is the equivalent of Yardstick's -r/--range: it makes a run repeatable against the same rows and lets a get actually hit. 'unbounded' is the pre-v10 behaviour.",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/key_space_unbounded"
        },
        {
          "$ref": "#/$defs/key_space_bounded"
        }
      ],
      "default": {
        "kind": "unbounded"
      }
    },
    "key_space_unbounded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "unbounded",
          "description": "Write keys come from the key column's own value_source; reads sample only keys this process wrote during this run. An ever-growing dataset, and unusable for measurement."
        }
      }
    },
    "key_space_bounded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "size",
        "distribution"
      ],
      "properties": {
        "kind": {
          "const": "bounded"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "default": 1000000,
          "description": "Number of distinct keys. NOTE: in bounded mode the key space SUPERSEDES the root key column's value_source, which must be a 'sequence'. Writes overwrite by construction, and a get-only run must be preceded by a put run or every read misses."
        },
        "distribution": {
          "enum": [
            "uniform",
            "zipfian",
            "latest"
          ],
          "default": "uniform",
          "description": "uniform: every key equally likely, a cache's worst case. zipfian: a hot head and a long cold tail. latest: skewed toward the most recently written keys."
        }
      }
    }
  }
}
